# Backend Firebase Admin Config
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key

FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_PRIVATE_KEY_WITH_ESCAPED_NEWLINES

# Neon Database (already configured)
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated allowed frontend origins for CORS
FRONTEND_URLS=http://localhost:5173

# Required for parcel route distance/ETA in Parcel APIs.
# Distance is Google-only; missing/invalid key will make estimate fail.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_SERVER_KEY

# Optional: allow backend OTP fallback mode in production when Firebase captcha fails
# In non-production this fallback is enabled automatically
ALLOW_SERVER_OTP=false

# Order Alert Email (new order notification)
# Set Gmail app-password credentials or any SMTP credentials.
ORDER_ALERT_ENABLED=true
ORDER_ALERT_TO=blinkiefash@gmail.com
ORDER_ALERT_FROM=blinkiefash@gmail.com
ORDER_ALERT_SMTP_SERVICE=gmail
ORDER_ALERT_SMTP_USER=blinkiefash@gmail.com
ORDER_ALERT_SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
# Alternative to SMTP service (if not using service):
# ORDER_ALERT_SMTP_HOST=smtp.gmail.com
# ORDER_ALERT_SMTP_PORT=587
# ORDER_ALERT_SMTP_SECURE=false
